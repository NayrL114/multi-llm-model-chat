# Copy this file to `.env` (repo root) and fill in your keys.
# The server only ever READS this file; nothing in the app writes secrets to disk.
# Editing .env while `npm run dev` is running restarts the server automatically.

# --- Provider keys (same names as llm-file-test-app) ---
# A provider with no key is shown as unavailable in the model picker.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgres://mmchat:mmchat@localhost:5434/mmchat

# --- Server ---
PORT=3001

# Log the exact messages sent to each lane (console + server/logs/lane-payloads.jsonl).
# Use this to check lane separation directly instead of trusting replies.
LOG_PAYLOADS=true

# Offer free, offline "Mock" models that echo back what they were sent.
# Handy for testing threads, branching, stop and retry without spending money.
ENABLE_MOCK_MODELS=true
