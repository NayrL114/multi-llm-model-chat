{
  "name": "multi-model-chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm -w server run dev\" \"npm -w web run dev\"",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "npm -w server run db:generate",
    "db:migrate": "npm -w server run db:migrate",
    "db:studio": "npm -w server run db:studio",
    "typecheck": "npm -w shared run typecheck && npm -w server run typecheck && npm -w web run typecheck",
    "test": "npm -w server run test",
    "build": "npm -w web run build",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "engines": {
    "node": ">=22"
  }
}
